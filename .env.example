# ============================================================
# SUNDAY — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit your actual .env file to GitHub.
# ============================================================

# ── REQUIRED ────────────────────────────────────────────────

# Your Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key(s) — comma-separated for key rotation
# Get free keys at: https://aistudio.google.com/apikey
GEMINI_API_KEYS=

# Gemini model to use (default shown below)
GEMINI_MODEL=

# Your Telegram user ID(s) — only these users can use the bot
# Find your ID by messaging @userinfobot on Telegram
ALLOWED_USER_IDS=your_telegram_user_id_here

# ── OPTIONAL: Persistent Memory (Supabase) ──────────────────

# Get these from your Supabase project → Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ── OPTIONAL: Web Search ─────────────────────────────────────

# Tavily API (https://tavily.com) — for web research tool
TAVILY_API_KEY=your_tavily_api_key_here

# Serper API (https://serper.dev) — for Google search tool
SERPER_API_KEY=your_serper_api_key_here

# ── OPTIONAL: LLM Fallback ───────────────────────────────────

# OpenRouter (https://openrouter.ai) — fallback when Gemini is rate-limited
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── OPTIONAL: Job Search ─────────────────────────────────────

# Apify (https://apify.com) — for job listing scrapers
APIFY_API_TOKEN=your_apify_token_here

# ── OPTIONAL: Heartbeat / Proactive Messages ─────────────────

# Telegram chat ID to receive daily proactive check-ins
HEARTBEAT_CHAT_ID=your_telegram_chat_id_here

# ── OPTIONAL: Webhook ────────────────────────────────────────

WEBHOOK_PORT
WEBHOOK_SECRET

# ── OPTIONAL: UI ─────────────────────────────────────────────

# Set to false to hide which model answered at the bottom of responses
SHOW_MODEL_FOOTER=true
